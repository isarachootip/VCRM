// Prisma Schema for OmniService CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// Service CRM Models
// =======================

model Customer {
  id        String      @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  jobs      JobTicket[]
}

model Employee {
  id          String          @id @default(uuid())
  name        String
  role        Role
  skills      String[]        // e.g., ["AC_REPAIR", "PLUMBING"]
  createdAt   DateTime        @default(now())
  assignments JobAssignment[]
}

model JobTicket {
  id             String            @id @default(uuid())
  customerId     String
  serviceType    ServiceType
  status         JobStatus         @default(PENDING)
  scheduledDate  DateTime?
  description    String?
  totalAmount    Float?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer       Customer          @relation(fields: [customerId], references: [id])
  assignments    JobAssignment[]
  milestones     ProjectMilestone[]
  materials      JobMaterial[]
}

model JobAssignment {
  id          String    @id @default(uuid())
  jobId       String
  employeeId  String
  startTime   DateTime?
  endTime     DateTime?

  job         JobTicket @relation(fields: [jobId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model ProjectMilestone {
  id           String   @id @default(uuid())
  jobId        String
  phaseName    String
  status       String
  expectedDate DateTime?

  job          JobTicket @relation(fields: [jobId], references: [id])
}

model Inventory {
  id          String        @id @default(uuid())
  itemName    String
  stockQty    Int           @default(0)
  unitPrice   Float         @default(0)
  materials   JobMaterial[]
}

model JobMaterial {
  id          String    @id @default(uuid())
  jobId       String
  inventoryId String
  quantityUsed Int

  job         JobTicket @relation(fields: [jobId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
}

enum Role {
  ADMIN
  DISPATCHER
  TECHNICIAN
  DRIVER
}

enum ServiceType {
  DELIVERY
  INSTALL
  RENOVATE
  MAINTAIN
}

enum JobStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

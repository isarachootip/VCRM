{
  "name": "crm-monday-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mock:zwiz": "node --import tsx tests/mocks/zwiz-mock-server.ts",
    "mock:qualtrics": "node --import tsx tests/mocks/qualtrics-mock-server.ts",
    "mock:all": "node --import tsx tests/mocks/index.ts",
    "test": "node --import tsx tests/run-all.ts",
    "test:e2e": "node --import tsx tests/run-all.ts",
    "test:phase1": "node --import tsx tests/run-phase1.ts",
    "test:phase2": "node --import tsx tests/run-phase2.ts",
    "test:phase3": "node --import tsx tests/run-phase3.ts",
    "test:all-phases": "node --import tsx tests/run-all-phases.ts",
    "test:tier1": "node --import tsx --test tests/e2e/tier1-coverage/*.test.ts",
    "test:tier2": "node --import tsx --test tests/e2e/tier2-boundaries/*.test.ts",
    "test:tier3": "node --import tsx --test tests/e2e/tier3-combinations/*.test.ts",
    "test:tier4": "node --import tsx --test tests/e2e/tier4-scenarios/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
